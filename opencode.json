{
  "workspace": {
    "name": "app-design-definitions",
    "type": "technical-documentation",
    "language": "es-ES",
    "focus": [
      "architecture",
      "design-specifications",
      "application-definitions",
      "technical-decisions"
    ]
  },
  "copilot": {
    "profile": "principal-architect",
    "responseStyle": "professional",
    "verbosity": "medium",
    "defaultOutputFormat": "markdown",
    "enforceStructuredDocs": true,
    "priorities": [
      "clarity",
      "traceability",
      "security",
      "maintainability"
    ]
  },
  "plugins": {
    "superpowers": {
      "enabled": true,
      "mode": "workspace",
      "capabilities": [
        "scaffolding",
        "refactoring",
        "documentation-assist"
      ]
    }
  }
}
